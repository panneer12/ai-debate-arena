#!/bin/bash
# Pre-commit hook for AI Debate Arena
# Automatically formats code and checks for violations before commit

set -e

echo "Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get list of staged Python files
PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [ -z "$PYTHON_FILES" ]; then
    echo -e "${GREEN}✓ No Python files to check${NC}"
    exit 0
fi

echo "Checking Python files: $PYTHON_FILES"

# Check if required tools are installed
MISSING_TOOLS=()

if ! command -v black &> /dev/null; then
    MISSING_TOOLS+=("black")
fi

if ! command -v isort &> /dev/null; then
    MISSING_TOOLS+=("isort")
fi

if ! command -v flake8 &> /dev/null; then
    MISSING_TOOLS+=("flake8")
fi

if [ ${#MISSING_TOOLS[@]} -ne 0 ]; then
    echo -e "${RED}✗ Missing required tools: ${MISSING_TOOLS[*]}${NC}"
    echo "Install with: pip install -r requirements-dev.txt"
    exit 1
fi

# Auto-format with Black
echo -e "${YELLOW}Formatting code with Black...${NC}"
black $PYTHON_FILES
if [ $? -ne 0 ]; then
    echo -e "${RED}✗ Black formatting failed${NC}"
    exit 1
fi

# Auto-sort imports with isort
echo -e "${YELLOW}Sorting imports with isort...${NC}"
isort $PYTHON_FILES
if [ $? -ne 0 ]; then
    echo -e "${RED}✗ isort failed${NC}"
    exit 1
fi

# Re-add files that were formatted
git add $PYTHON_FILES

# Check code with flake8
echo -e "${YELLOW}Checking code with flake8...${NC}"
flake8 $PYTHON_FILES
if [ $? -ne 0 ]; then
    echo -e "${RED}✗ flake8 found violations${NC}"
    echo "Please fix the issues above before committing"
    exit 1
fi

echo -e "${GREEN}✓ All pre-commit checks passed!${NC}"
exit 0
