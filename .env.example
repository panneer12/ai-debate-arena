# Environment Variables for AI Debate Arena

# Google AI API Key (REQUIRED)
# Get your key from https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here

# Google Search API (for fact-checking)
# Optional for MVP, can use web scraping fallback
GOOGLE_SEARCH_API_KEY=your_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# LLM Configuration
LLM_MODEL=gemini-2.0-flash-exp
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Debate Configuration
MAX_DEBATE_ROUNDS=5
OPENING_STATEMENT_SECONDS=120
REBUTTAL_SECONDS=60
CLOSING_SECONDS=90

# Performance
AGENT_TIMEOUT_SECONDS=10
FACT_CHECK_TIMEOUT_SECONDS=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Deployment (for Cloud Run)
PORT=8080
HOST=0.0.0.0

# Memory/Cache
ENABLE_FACT_CACHE=true
FACT_CACHE_TTL_DAYS=7
