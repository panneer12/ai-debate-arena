# ============================================
# GOOGLE AI CONFIGURATION
# ============================================
# Get your API key from: https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here

# Google Search API (for fact-checking)
# Optional for MVP, can use web scraping fallback
GOOGLE_SEARCH_API_KEY=your_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# ============================================
# LLM SETTINGS
# ============================================
# Recommended stable models:
# - gemini-2.5-flash (Latest, fast and powerful - RECOMMENDED)
# - gemini-1.5-pro (Higher quality, more expensive)
# - gemini-2.0-flash-exp (Experimental, may have quota limits)
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ============================================
# DEBATE PROTOCOL SETTINGS
# ============================================
MAX_DEBATE_ROUNDS=5
OPENING_STATEMENT_SECONDS=120
REBUTTAL_SECONDS=60
CLOSING_SECONDS=90

# ============================================
# AGENT TIMEOUTS
# ============================================
AGENT_TIMEOUT_SECONDS=10
FACT_CHECK_TIMEOUT_SECONDS=5

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# DEPLOYMENT SETTINGS
# ============================================
# For local development
PORT=8080
HOST=0.0.0.0

# ============================================
# MEMORY/CACHE SETTINGS
# ============================================
ENABLE_FACT_CACHE=true
FACT_CACHE_TTL_DAYS=7

# ============================================
# CLOUD RUN DEPLOYMENT (Production)
# ============================================
# PORT is automatically set by Cloud Run
# Do not set PORT in production - Cloud Run injects it
# For local development, defaults to 8080

# For production deployment:
# 1. Store GOOGLE_API_KEY in Google Secret Manager
# 2. Use --set-secrets flag in deployment
# 3. See deployment/DEPLOYMENT_GUIDE.md for details
