# ============================================
# GOOGLE AI CONFIGURATION
# ============================================
# Get your API key from: https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here

# ============================================
# LLM SETTINGS
# ============================================
# Recommended stable models:
# - gemini-1.5-flash (Fast, lower cost)
# - gemini-1.5-pro (Higher quality)
# - gemini-2.0-flash-exp (Experimental, may have quota limits)
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# ============================================
# DEBATE PROTOCOL SETTINGS
# ============================================
MAX_DEBATE_ROUNDS=3
OPENING_STATEMENT_SECONDS=120
REBUTTAL_SECONDS=90
CLOSING_SECONDS=90

# ============================================
# AGENT TIMEOUTS
# ============================================
AGENT_TIMEOUT_SECONDS=30
FACT_CHECK_TIMEOUT_SECONDS=10

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=detailed
